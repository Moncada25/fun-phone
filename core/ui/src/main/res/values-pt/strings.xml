    <string name="menstrual_calendar_description">Acompanhe previsões do ciclo, janelas férteis e dicas rápidas.</string>
    <string name="menstrual_calendar_intro">Digite o primeiro dia do seu ciclo e obtenha uma estimativa de cada fase. Esta ferramenta é apenas informativa e não substitui orientação médica.</string>
